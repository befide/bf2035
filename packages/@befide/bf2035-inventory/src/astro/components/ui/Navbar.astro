---
import { Breadcrumbs } from "astro-breadcrumbs"

import "astro-breadcrumbs/breadcrumbs.css"


---

<header class="border-b border-border bg-muted dark:bg-muted/30 print:hidden">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-1 p-2">
    <div class="flex items-center">
      <a
        href="/"
        class="decoration-ring/50 underline-offset-2 focus-visible:underline focus-visible:outline-none"
      >
        <h1 class="text-2xl font-bold leading-none">FLORA-WEG</h1>
      </a>
      <Breadcrumbs ustomizeListElements={[{ index: 0, remove: true }]} />
    </div>
  </div>
</header>
