---
import "@/astro/styles/dc-explorer.css"
import DCExplorerCount from "./DCExplorerCount.astro"
import DCExplorerRowChart from "./DCExplorerRowChart.astro"
import DCExplorerBarChart from "./DCExplorerBarChart .astro"
import DCExplorerTable from "./DCExplorerTable.astro"

export type Theses = Thesis[]

export interface Thesis {
  citationKey: string
  title: string
  author: Author
  language: string
  year: number
  university: string
  organizations: string[]
  facilities: string[]
  degree: string
}

export interface Author {
  familyName: string
  givenName: string
  gender: string
}

const locale = Astro.currentLocale
---

<div id="explorer" class="explorer" data-locale={locale}>
  <div class="filters">
    <details open>
      <summary>Filter</summary>

      <DCExplorerCount collection="theses" dimension="count" />
      <DCExplorerBarChart collection="theses" dimension="year" title="Year" />
      <DCExplorerRowChart collection="theses" dimension="degree" title="Degree" />
      <DCExplorerRowChart
        collection="theses"
        dimension="gender"
        title="Gender"
        accessorPath="author.gender"
      />
      <DCExplorerRowChart collection="theses" dimension="university" title="University" />
      <DCExplorerRowChart
        collection="theses"
        dimension="facilities"
        title="Facility"
        is-array={true}
      />

      <DCExplorerRowChart collection="theses" dimension="language" title="Language" />
    </details>
  </div>
  <div class="explorer__items">
    <div class="table-responsive col-md-12">
      <h4>Filtered Records</h4>
      <DCExplorerTable collection="theses" dimension="id" />
    </div>
  </div>
</div>
<script>
  import { $thesesIndex } from "@/astro/store/thesesIndex"
  import "dc/src/compat/d3v6"

  import { config, redrawAll, renderAll } from "dc"

  import {
    charts,
    createBarChart,
    createRowChart,
    createCountChart,
    createTableChart,
    getTableConfig,
    getValue,
  } from "./utils"

  config.defaultColors(["schemeCategory10"])

  $thesesIndex.listen(() => {
    const idx = $thesesIndex.get()

    const filters = document.getElementsByClassName("dc-explorer__tile")
    Array.from(filters).forEach((filter) => {
      const { dcTileType, dcCollection, dcDimension, dcAccessorPath, dcDimensionMultiple } =
        filter.dataset

      if (dcTileType === "count") {
        /*something here*/

        createCountChart(dcCollection, dcDimension, idx)
      } else if (dcTileType === "row-chart") {
        // something here

        const dimension = idx.dimension(
          (d) => getValue(d, dcAccessorPath || dcDimension) || "other",
          dcDimensionMultiple
        )
        const group = dimension.group().reduceCount()

        createRowChart(dcCollection, dcDimension, dimension, group)
      } else if (dcTileType === "bar-chart") {
        const dimension = idx.dimension(
          (d) => getValue(d, dcAccessorPath || dcDimension) || "other"
        )

        const group = dimension.group()

        createBarChart(dcCollection, dcDimension, dimension, group)
      } else if (dcTileType === "table") {
        const idDimension = idx.dimension((d) => d)
        // const group = dimension.group()

        createTableChart(dcCollection, dcDimension, getTableConfig("theses"), idDimension)
      }
    })

    renderAll()

    const resetButtons = document.querySelectorAll("button.reset")
    resetButtons.forEach((button) => {
      button.addEventListener("click", function (e) {
        const chartId = (e.currentTarget as HTMLElement).getAttribute("data-chart")
        console.log(chartId)
        if (chartId) charts.get(chartId)?.filterAll()

        redrawAll()
        e.preventDefault()
      })
    })
  })
</script>

