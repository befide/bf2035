---
import "@/astro/styles/dc-explorer.css"
import DCExplorerCount from "@components/dc/DCExplorerCount.astro"
import DCExplorerRowChart from "@components/dc/DCExplorerRowChart.astro"
import DCExplorerBarChart from "@components/dc/DCExplorerBarChart .astro"
import DCExplorerTable from "@components/dc/DCExplorerTable.astro"
import DCExplorer from "@components/dc/DCExplorer.astro"
---

<DCExplorer collection="theses">
  <div class="dc-explorer__filters">
    <DCExplorerCount
      collection="theses"
      dimension="count"
    />
    <DCExplorerBarChart
      collection="theses"
      dimension="year"
      title="Year"
    />
    <DCExplorerRowChart
      collection="theses"
      dimension="degree"
      title={Astro.locals.t(
        "dc-explorer.tiles.title.degree"
      )}
    />
    <DCExplorerRowChart
      collection="theses"
      dimension="gender"
      title={Astro.locals.t(
        "dc-explorer.tiles.title.gender"
      )}
      accessorPath="author.gender"
    />
    <DCExplorerRowChart
      collection="theses"
      dimension="university"
      title={Astro.locals.t(
        "dc-explorer.tiles.title.university"
      )}
    />
    <DCExplorerRowChart
      collection="theses"
      dimension="facilities"
      title={Astro.locals.t(
        "dc-explorer.tiles.title.facilities"
      )}
      dimensionIsArray={true}
    />

    <DCExplorerRowChart
      collection="theses"
      dimension="language"
      title={Astro.locals.t(
        "dc-explorer.tiles.title.language"
      )}
    />
    <!-- </details> -->
  </div>
  <div class="dc-explorer__items">
    <DCExplorerTable
      collection="theses"
      dimension="id"
    />
  </div>
</DCExplorer>
