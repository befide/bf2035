---
import { Icon } from "@astrojs/starlight/components"
import { AstroError } from "astro/errors"

const asideVariants = ["table", "note", "tip", "caution", "danger"] as const
const icons = {
  table: "table",
  note: "information",
  tip: "rocket",
  caution: "warning",
  danger: "error",
} as const

interface Props {
  type?: (typeof asideVariants)[number]
  title?: string
}

let { type = "table", title } = Astro.props

if (!asideVariants.includes(type)) {
  throw new AstroError(
    "Invalid `type` prop passed to the `<Aside>` component.\n",
    `Received: ${JSON.stringify(type)}\n` +
      `Expected one of ${asideVariants.map((i) => JSON.stringify(i)).join(", ")}`
  )
}

if (!title) {
  title = Astro.locals.t(`aside.${type}`)
}
---

<aside aria-label={title} class={`aside aside--${type}`}>
  <p class="aside__title" aria-hidden="true">
    <span class={"icon icon--" + type}></span>
    <span class="title">{title}</span>
  </p>
  <div class="aside__content">
    <slot />
  </div>
</aside>

<style>
  @layer my-overrides {
    .aside__title {
      height: 1rem;
      background-color: red;
    }
    .icon {
      /* color: var(--sl-icon-color); */
      font-size: 1rem;
      width: 1rem;
      height: 1rem;
      background-size: contain;
    }
    .icon--table {
      background-image: url("data:image/svg+xml;base64,");
    }
  }
</style>
