---
import type { SectionTreeNode } from '@lib/sections'

export type Props = {
  node: SectionTreeNode
}

const { node: tocItem } = Astro.props
---

<li data-depth={tocItem.depth} data-path={tocItem?.id}>
  {
    !tocItem.data.data.excludeFromTour && (
      <a href={'/' + tocItem?.data?.id}>
        <span class="section-number">
          {tocItem.data && tocItem.data?.data.sectionNumber}
        </span>
        <span class="section-title">
          {tocItem.data && tocItem.data?.data.title} {tocItem.depth}
        </span>
      </a>
    )
  }
  {
    tocItem.children?.length && (
      <ul data-path={tocItem?.data?.id}>
        {tocItem.children?.map((child) => (
          <Astro.self node={child} />
        ))}
      </ul>
    )
  }
</li>

<style>
  li > a {
    display: flex;
    gap: 1rem;
  }
  li > a span {
    display: inline-block;
  }
  .section-number {
    flex: 0 0 3rem;
    text-align: right;
  }
  .section-title {
    flex: 1 0 5rem;
  }

  [data-depth='2'] .section-title {
    text-transform: uppercase;
    font-weight: bold;
  }
  [data-depth='3'] .section-title {
    text-transform: none;
    font-weight: normal;
    font-weight: bold;
  }
  [data-depth='4'] .section-title,
  [data-path*='frontmatter'][data-depth='2'] .section-title {
    text-transform: none;
    font-weight: normal;
  }

  [data-path*='body-matter'][data-depth='2'] {
    margin-bottom: 1rem;
  }
  [data-path*='body-matter'][data-depth='3'] {
    display: flex;
    flex-direction: column;
  }
  [data-path*='body-matter'][data-depth='4'] {
    flex-direction: column;
  }
  [data-depth='4'][data-path='de/02-body-matter'] {
    display: flex;
    flex-direction: row;
    width: 100%;
    gap: 1rem;
  }
  [data-depth='2'][data-path='de/02-body-matter'] li {
    flex: 0 0 15rem;
  }
</style>
