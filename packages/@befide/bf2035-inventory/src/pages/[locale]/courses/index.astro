---
import CoursesExplorer from "@components/domain/CoursesExplorer.astro"
import DCExplorerLayout from "@/astro/layouts/DCExplorerLayout.astro"

export async function getStaticPaths(): Promise<any> {
  const locales = ["en", "de"]

  return locales.map((locale) => ({
    params: { locale },
    props: {},
  }))
}
---

<DCExplorerLayout title="Courses Explorer" description="Courses Explorer">
  <main>
    <CoursesExplorer />
  </main>
</DCExplorerLayout>
