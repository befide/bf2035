{
  "extends": "astro/tsconfigs/strict",
  "include": ["./astro.config.ts", "./src/**/*.ts", "./src/**/*.astro"],
  "exclude": ["./scripts/download-grist.ts"],
  "compilerOptions": {
    "types": [
      "astro/client",
      "vite-plugin-pwa/vanillajs",
      "vite-plugin-pwa/info"
    ],
    "plugins": [
      {
        "name": "@astrojs/ts-plugin"
      }
    ],
    "strictNullChecks": true,
    "skipLibCheck": true,
    "baseUrl": "./",
    "paths": {
      "@/*": ["./src/*"],
      "@ui/*": ["./src/astro/components/ui/*"],
      "@components/*": ["./src/astro/components/*"],
      "@styles/*": ["./src/app/styles/*"],
      "@utils/*": ["./src/astro/utils/*"],
      "@layouts/*": ["./src/astro/layouts/*"],
      "@lib/*": ["./src/astro/lib/*"],
      "@content/*": ["./src/content/*"],
      "@assets/*": ["./src/astro/assets/*"],
      "@astro/*": ["./src/astro/*"],
      "@domain/*": ["./src/lib/domain/*"],
      "@nanostores/*": ["./src/lib/nanostores/*"]
    }
  }
}
