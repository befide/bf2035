---
import "@/astro/styles/dc-explorer.css"

const { collection } = Astro.props

const locale = Astro.currentLocale
---

<dc-explorer
  class="dc-explorer"
  data-collection={collection}
  data-locale={locale}
>
  <slot />
</dc-explorer>

<script>
  import "dc/src/compat/d3v6"

  import {
    config,
    redrawAll,
    renderAll
  } from "dc"

  import {
    charts,
    createBarChart,
    createRowChart,
    createCountChart,
    createTableChart,
    getTableConfig,
    getValue,
    getLocale,
    createTreeDataTableChart,
    getTreeTableConfig
  } from "./utils"
  import { getCollectionIndex } from "@/astro/store"
  const locale = getLocale()

  class DCExplorer extends HTMLElement {
    connectedCallback() {
      config.defaultColors([
        "schemeCategory10"
      ])

      const collection =
        this.dataset.collection

      const $idx =
        getCollectionIndex(collection)

      $idx?.listen(() => {
        const idx = $idx.get()

        if (idx) {
          const filters =
            document.getElementsByClassName(
              "dc-explorer__tile"
            ) as HTMLCollectionOf<HTMLElement>
          Array.from(filters).forEach(
            (filter) => {
              const {
                dcTileType,
                dcCollection,
                dcDimensionIsLocalized,
                dcDimension,
                dcAccessorPath,
                dcDimensionIsArray
              } = filter.dataset

              if (
                !dcTileType ||
                !dcCollection ||
                !dcDimension
              )
                return

              if (
                dcTileType === "count"
              ) {
                /*something here*/

                createCountChart(
                  dcCollection,
                  dcDimension,
                  idx
                )
              } else if (
                dcTileType ===
                "row-chart"
              ) {
                // something here

                const valuePath =
                  dcDimensionIsLocalized ===
                  "true"
                    ? dcAccessorPath ||
                      dcDimension
                    : dcAccessorPath ||
                      dcDimension

                const dimension =
                  idx.dimension(
                    (d) =>
                      getValue(
                        d,
                        valuePath
                      ) || "",
                    dcDimensionIsArray !==
                      "false"
                  )

                const group = dimension
                  .group()
                  .reduceCount()

                createRowChart(
                  dcCollection,
                  dcDimension,
                  dimension,
                  group
                )
              } else if (
                dcTileType ===
                "bar-chart"
              ) {
                const dimension =
                  idx.dimension(
                    (d) =>
                      getValue(
                        d,
                        dcAccessorPath ||
                          dcDimension
                      ) || "other"
                  )

                const group =
                  dimension.group()

                createBarChart(
                  dcCollection,
                  dcDimension,
                  dimension,
                  group
                )
              } else if (
                dcTileType === "table"
              ) {
                const idDimension =
                  idx.dimension(
                    (d) => d
                  )

                createTableChart(
                  dcCollection,
                  dcDimension,
                  getTableConfig(
                    dcCollection,
                    locale
                  ),
                  idDimension
                )
              } else if (
                dcTileType ===
                "tree-data-table"
              ) {
                const idDimension =
                  idx.dimension(
                    (d) => d
                  )

                createTreeDataTableChart(
                  dcCollection,
                  dcDimension,
                  getTreeTableConfig(
                    dcCollection,
                    locale
                  ),
                  idDimension
                )
              }
            }
          )

          renderAll()

          const resetButtons =
            document.querySelectorAll(
              ".dc-explorer__tile__actions button.reset-action"
            )
          resetButtons.forEach(
            (button) => {
              button.addEventListener(
                "click",
                function (e) {
                  const chartId = (
                    e.currentTarget as HTMLElement
                  ).getAttribute(
                    "data-chart"
                  )

                  if (chartId) {
                    charts
                      .get(chartId)
                      ?.filterAll()
                  } else {
                    charts.forEach(
                      function (chart) {
                        chart.filter(
                          null
                        )
                      }
                    )
                  }

                  redrawAll()
                  e.preventDefault()
                }
              )
            }
          )
        }
      })
    }
  }
  customElements.define(
    "dc-explorer",
    DCExplorer
  )
</script>
