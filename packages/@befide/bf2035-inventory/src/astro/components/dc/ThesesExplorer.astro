---
import "@/astro/styles/dc-explorer.css"
import DCExplorerCount from "./DCExplorerCount.astro"
import DCExplorerRowChart from "./DCExplorerRowChart.astro"
import DCExplorerBarChart from "./DCExplorerBarChart .astro"
import DCExplorerTable from "./DCExplorerTable.astro"
import DCExplorer from "./DCExplorer.astro"
import DCExplorerFilters from "./DCExplorerFilters.astro"
import DCExplorerItems from "./DCExplorerItems.astro"

export type Theses = Thesis[]

export interface Thesis {
  citationKey: string
  title: string
  author: Author
  language: string
  year: number
  university: string
  organizations: string[]
  facilities: string[]
  degree: string
}

export interface Author {
  familyName: string
  givenName: string
  gender: string
}

const locale = Astro.currentLocale
---

<DCExplorer>
  <div class="filters">
    <!-- <h2>{Astro.locals.t("dc-explorer.filters")}</h2> -->
    <details open>
      <summary>{Astro.locals.t("dc-explorer.filters")}</summary>

      <DCExplorerCount collection="theses" dimension="count" />
      <DCExplorerBarChart collection="theses" dimension="year" title="Year" />
      <DCExplorerRowChart collection="theses" dimension="degree" title="Degree" />
      <DCExplorerRowChart
        collection="theses"
        dimension="gender"
        title="Gender"
        accessorPath="author.gender"
      />
      <DCExplorerRowChart collection="theses" dimension="university" title="University" />
      <DCExplorerRowChart
        collection="theses"
        dimension="facilities"
        title="Facility"
        is-array={true}
      />

      <DCExplorerRowChart collection="theses" dimension="language" title="Language" />
    </details>
  </div>
  <div class="explorer__items">
    <h2>{Astro.locals.t("dc-explorer.items")}</h2>
    <DCExplorerTable collection="theses" dimension="id" />
  </div>
</DCExplorer>
