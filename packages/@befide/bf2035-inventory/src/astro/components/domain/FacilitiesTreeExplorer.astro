---
import "@/astro/styles/dc-explorer.css"
import DCExplorerCount from "@components/dc/DCExplorerCount.astro"
import DCExplorerRowChart from "@components/dc/DCExplorerRowChart.astro"
import DCExplorer from "@components/dc/DCExplorer.astro"
import DCExplorerTreeDataTable from "../dc/DCExplorerTreeDataTable.astro"
---

<DCExplorer collection="facilities">
  <div class="dc-explorer__filters">
    <DCExplorerCount collection="facilities" dimension="count" />

    <DCExplorerRowChart collection="facilities" dimension="instanceOf" title="instanceOf" />
    <DCExplorerRowChart collection="facilities" dimension="lifeCycle" title="lifeCycle" />
    <DCExplorerRowChart
      collection="facilities"
      dimension="primaryBeamParticles"
      title="primaryBeamParticles"
      is-array={true}
    />
    <DCExplorerRowChart
      collection="facilities"
      dimension="secondaryBeamParticles"
      title="secondaryBeamParticles"
      is-array={true}
    />
  </div>
  <div class="dc-explorer_items">
    <DCExplorerTreeDataTable collection="facilities" dimension="id" />
  </div>
</DCExplorer>
