---
import "@/astro/styles/dc-explorer.css"
import DCExplorerCount from "@components/dc/DCExplorerCount.astro"
import DCExplorerRowChart from "@components/dc/DCExplorerRowChart.astro"
import DCExplorerBarChart from "@components/dc/DCExplorerBarChart .astro"
import DCExplorerTable from "@components/dc/DCExplorerTable.astro"
import DCExplorer from "@components/dc/DCExplorer.astro"
---

<DCExplorer collection="organizations">
  <div class="dc-explorer__filters">
    <DCExplorerCount collection="organizations" dimension="count" />
    <DCExplorerRowChart
      collection="community"
      dimension="befideOrganizationCategories"
      title="Category"
      dimensionIsArray={true}
    />
    <DCExplorerRowChart collection="organizations" dimension="location__country" title="Country" />

    <!-- </details> -->
  </div>
  <div class="dc-explorer__items">
    <DCExplorerTable collection="organizations" dimension="id" />
  </div>
</DCExplorer>
