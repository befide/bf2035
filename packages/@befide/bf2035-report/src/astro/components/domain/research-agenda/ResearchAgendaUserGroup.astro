---
import type { ResearchAgenda } from './research-agenda'
import _data from './research-agenda.json'

let data: ResearchAgenda = Object.values(_data)

export interface Props {
  filter: string
}

const { filter } = Astro.props

const item = data.find((item) => item.path === filter)
---

<figure class="user-group">
  <div class="container">
    <object
      data={'/svg/research-agenda/' + filter + '.svg'}
      type="image/svg+xml"></object>
  </div>
  <figcaption>
    <slot />
  </figcaption>
</figure>

<style>
  figure {
    display: flex;
    flex-direction: row-reverse;
    width: 27rem;
    height: 11rem;
    position: relative;
  }

  .container {
    flex: 0 0 12rem;
    position: relative;
  }
  object {
    position: absolute;
    width: 19rem;
    height: 19rem;
    top: -4rem;
    left: -5rem;
  }

  figcaption {
    flex: 1;
  }
</style>
