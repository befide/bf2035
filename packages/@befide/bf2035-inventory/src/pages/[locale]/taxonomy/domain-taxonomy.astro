---
import TaxonomyTree from "@/astro/components/domain/TaxonomyTree.astro"
import DCExplorerLayout from "@/astro/layouts/DCExplorerLayout.astro"

export async function getStaticPaths(): Promise<any> {
  const locales = ["en", "de"]

  return locales.map((locale) => ({
    params: { locale },
    props: {},
  }))
}
---

<DCExplorerLayout title="Abrechnung" description="Statements">
  <main>
    <TaxonomyTree isDomainSpecific={true} />
  </main>
</DCExplorerLayout>
