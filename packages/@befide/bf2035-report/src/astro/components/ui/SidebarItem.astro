---
import { getPath } from '@utils/getSections';
import type { SectionTreeNode } from '@utils/getSections';

export type Props = {
  node: SectionTreeNode;
};

const { node } = Astro.props;
---

<li class={`sidebar-item depth-${node.depth}`} data-path={node.data?.id}>
  {
    !node.data?.data?.excludeFromToc && (
      <a href={'/' + node?.data?.id}>
        <span class="section-number">
          {node.data && node.data?.data.sectionNumber}
        </span>
        <span class="section-title">{node.data && node.data?.data.title}</span>
      </a>
    )
  }
  <ul
    class={`sidebar-items depth-${node.depth + 1}`}
    data-path={node?.data?.id}
  >
    {node.children?.map((child) => <Astro.self node={child} />)}
  </ul>
</li>

<style></style>
