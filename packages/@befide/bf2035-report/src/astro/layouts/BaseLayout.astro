---
import Base from './Base.astro'

import Header from '@components/ui/LayoutHeader.astro'
import Footer from '@components/ui/LayoutFooter.astro'
import MobileMenuToggle from '@components/ui/MobileMenuToggle.astro'
import Sidebar from '@components/ui/Sidebar.astro'
import SettingsDebugToggle from '../components/ui/SettingsDebugToggle.astro'
import SettingsFitSpreadToggle from '../components/ui/SettingsFitSpreadToggle.astro'
import SettingsPrintPreviewToggle from '../components/ui/SettingsPrintPreviewToggle.astro'
import Navigation from '../components/ui/Navigation.astro'

const { lang, title } = Astro.props
---

<Base {lang} {title}>
  <div id="layout" class="layout">
    <header id="nav" class="layout__header bg-gray-200">
      <Header />
    </header>
    <main id="main" class="layout__main p-4">
      <slot />
    </main>
    <aside class="toolbox">
      <Navigation />
      <hr />
      <div class="toolbox-item">
        <SettingsPrintPreviewToggle />
      </div>
      <!-- <SettingsThemeToggle /> -->
      <div class="toolbox-item">
        <SettingsDebugToggle />
      </div>
      <div class="toolbox-item">
        <SettingsFitSpreadToggle />
      </div>
    </aside>
    <footer class="layout__footer bg-gray-200">
      <Footer />
    </footer>
  </div>
</Base>
<script>
  function render() {
    import('pagedjs').then((pagedjs) => {
      const previewer = new pagedjs.Previewer()

      const inputNode = document.getElementById('main')

      if (inputNode != null) {
        const clone = inputNode

        const fragment = document.createDocumentFragment()
        fragment.appendChild(clone)

        //   document.body.setAttribute("data-pagedjs-mode", props.mode);

        previewer.preview(fragment, null).then((flow: any) => {
          console.log(flow)
        })
      }
    })
  }
  document.addEventListener('keydown', function (e) {
    if (e.ctrlKey && e.code === 'KeyP') {
      render()
    }
  })
</script>

<style is:global>
  .toolbox {
    position: fixed;
    right: -6rem;
    top: 10rem;
    width: 8rem;
    z-index: 10000;
    overflow: hidden;

    transition: 0.1s;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.5rem;
    box-shadow: 0 0 1px rgba(0, 0, 0, 0.9);
  }
  .toolbox:hover {
    right: -0rem;
    transition: 0.1s;
  }
  .toolbox .toolbox-item {
    flex: 1 1 100%;
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-size: var(--text-xs);
    white-space: nowrap;

    margin-right: -80px;

    top: 10rem;
  }
  .toolbox:hover .toolbox-item {
    margin-right: 0px;
  }

  .layout__footer {
    padding: 1rem;
  }
</style>
