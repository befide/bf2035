
.layout {
  position: relative;
  width: 100vw;
  min-height: 100vh;
}

.layout__header, .layout__footer {
  position: sticky;
  width: 100vw;
  height: calc(3 * var(--ui__baseline-height));
  display: flex;
  box-shadow: 0px 0px 2px #999;
  background-color: #eee;
  overflow: hidden;
  z-index: 100;
}

// .content-wrapper {
// width: var(--spread--width);
// margin: 0 auto;
// }
@media screen {
  [data-fit-spread=true] {
    .layout {
      min-height: 100vh;
    }

    .layout__main {
      height: 100vh;
    }

    .layout__main {
      transform-origin: 50% 0%;
      transform: scale(0.75);
    }
  }

  .layout__footer {
    bottom: 0;
  }

  .layout__header {
    top: 0;
  }
}

#footnote-label {
  display: none;
}
