---
import "@/astro/styles/dc-explorer.css"
import DCExplorerCount from "@components/dc/DCExplorerCount.astro"
import DCExplorerRowChart from "@components/dc/DCExplorerRowChart.astro"
import DCExplorer from "@components/dc/DCExplorer.astro"
import DCExplorerTable from "../dc/DCExplorerTable.astro"
---

<DCExplorer collection="courses">
  <div class="filters">
    <details open>
      <summary>{Astro.locals.t("dc-explorer.filters")}</summary>

      <DCExplorerCount collection="courses" dimension="count" />
      <DCExplorerRowChart
        collection="courses"
        dimension="university"
        accessorPath="university"
        dimensionIsLocalized={true}
        title="University"
      />
      <DCExplorerRowChart
        collection="courses"
        dimension="instanceOfTeachingEvent"
        dimensionIsLocalized={true}
        accessorPath="instanceOfTeachingEvent"
        title="Teaching event"
      />
      <DCExplorerRowChart
        collection="courses"
        dimension="addressesProgrammeOfStudyLevels"
        dimensionIsLocalized={true}
        dimensionIsArray={true}
        title="Study level"
      />
      <DCExplorerRowChart collection="courses" dimension="semester" title="Semester" />
      <DCExplorerRowChart collection="courses" dimension="sws" title="SWS" />

      <DCExplorerRowChart
        collection="courses"
        dimension="language"
        title="Language"
        dimensionIsArray={true}
      />
    </details>
  </div>
  <div class="explorer__items">
    <h2>{Astro.locals.t("dc-explorer.items")}</h2>
    <DCExplorerTable collection="courses" dimension="id" />
  </div>
</DCExplorer>
