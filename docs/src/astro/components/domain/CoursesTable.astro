---
import { getCourses } from "@utils/content.courses"
import { getEntry } from "astro:content"
import type { CollectionEntry } from "astro:content"
import Badge from "./../Badge.astro"

interface Props {
  universityId?: string
}

let { universityId } = Astro.props

const isBachelorCourse = (course: CollectionEntry<"courses">) =>
  course.data.addressesProgrammeOfStudyLevels?.find((d) => d.id.indexOf("bachelor") > -1)
const isMasterCourse = (course: CollectionEntry<"courses">) =>
  course.data.addressesProgrammeOfStudyLevels?.find((d) => d.id.indexOf("master") > -1)

const university = universityId && (await getEntry("organizations", universityId))
const universityLabel = university && university.data.label.short.en

const courses = await getCourses(universityId)
const masterCourses = courses.filter(isMasterCourse)
const bachelorCourses = courses.filter(isBachelorCourse)
const getUniversity = async (course: CollectionEntry<"courses">) => {
  if (!course.data.offeredByUniversity) return null
  const university = await getEntry(course.data.offeredByUniversity)
  return university
}
---

<section>
  <p>
    Per academic year, {universityLabel} offers {courses.length} courses related to accelerator research of which
    {!bachelorCourses.length && <span>all addresses bachelor students.</span>}
    anf
    {!masterCourses.length && <span>all addresses master students.</span>}
  </p>
  <table id="dc-table-graph">
    <thead>
      <tr class="table-header">
        {!universityId && <th>university</th>}
        <th>programme</th>
        <th>semester</th>
        <th>language</th>
        <th>title</th>
        <th>sws</th>
      </tr>
    </thead>
    <tbody>
      {
        courses.map(async (course) => (
          <tr>
            {!universityId && <td class="nowrap">{(await getUniversity(course))?.data.label.short.en}</td>}
            <td>{course.data.semester}</td>
            <td>{course.data.language}</td>
            <td>
              {course.data.isInstanceOfTeachingEvent &&
                (await getEntry(course.data.isInstanceOfTeachingEvent)).data.term.en}
            </td>
            <td>
              {" "}
              <div class="course__badges">
                {isBachelorCourse(course) && <Badge alt="Bachelor Program" prefix="" text="Bachelor" size="small" />}
                {isMasterCourse(course) && <Badge alt="Bachelor Program" prefix="" text="Master" size="small" />}
              </div>
            </td>
            <td>
              <span class="course__title">{course.data.label.fullName.en}</span>
            </td>
            <td>{course.data.sws}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</section>
