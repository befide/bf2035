  <script>
    import crossfilter from "crossfilter2"

    import { format, scaleLinear } from "d3"

    import { config, dataCount, rowChart, barChart, renderAll } from "dc"

    const charts = new Map<String, any>()

    // config.disableTransitions = true;
    config.defaultColors(["schemeCategory10"])

    function createRowChart(id: string, dimension: any, group: any) {
      const containerElement = document.getElementById(
        "dc-explorer__tile__chart--" + id
      )?.parentElement?.parentElement
      const chart = rowChart("#dc-explorer__tile__chart--" + id)
        .width(tileWidth)
        .renderTitleLabel(true)
        .transitionDuration(100)
        .labelOffsetX(-tileWidth * (1 - rowBarRatio))
        .titleLabelOffsetX(tileWidth * rowBarRatio + 0.25 * baselineHeight)
        .title((d) => d.value)
        .label((d) => d.key)
        .margins({ ...margins, left: tileWidth * (1 - rowBarRatio) })
        .height((group.all().length + 0.5) * baselineHeight)
        .fixedBarHeight(0.75 * baselineHeight)
        .gap(0.25 * baselineHeight)
        .elasticX(true)
        .dimension(dimension)
        .group(group)

      chart.on("renderlet", () => {
        chart.hasFilter()
          ? containerElement?.classList.add("filtered")
          : containerElement?.classList.remove("filtered")
      })

      charts.set(id, chart)
      return chart
    }
    function createBarChart(id: string, dimension: any, group: any) {
      const containerElement = document.getElementById(
        "dc-explorer__tile__chart--" + id
      )?.parentElement?.parentElement
      const chart = barChart("#dc-explorer__tile__chart--" + id)
        .x(
          scaleLinear().domain([
            (allYears[0] || 0) - 1,
            (allYears[allYears.length - 1] || 2000) + 0.5,
          ])
        )
        .elasticY(true)
        .elasticX(false)
        .centerBar(true)
        .dimension(dimension)
        .group(group)
        .margins({
          ...margins,
          bottom: 2 * baselineHeight,
          right: 1 * baselineHeight,
        })
        // .ordinalColors(["#f0f0f0"])
        .renderHorizontalGridLines(true)
        .transitionDuration(200)
        .on("renderlet", () => {
          chart.hasFilter()
            ? containerElement?.classList.add("filtered")
            : containerElement?.classList.remove("filtered")
        })

      chart.xAxis().ticks(5).tickFormat(format("2"))
      chart.yAxis().ticks(3)

      charts.set(id, chart)
      return chart
    }

    const theses = await fetch("/api/theses.json").then((response) =>
      response.json()
    )

    const idx = crossfilter(theses)

    const universityDimension = idx.dimension(
      (d: any) => d["universityId"] || "none"
    )
    const universityGroup = universityDimension.group().reduceCount()

    const yearDimension = idx.dimension((d: any) => d.year)
    const yearGroup = yearDimension.group().reduceCount()
    const allYears = yearGroup
      .top(Infinity)
      .map((y) => +y.key)
      // .filter((y) => y !== "")
      .sort()

    const degreeDimension = idx.dimension((d: any) => d.degree)
    const degreeGroup = degreeDimension.group().reduceCount()

    const genderDimension = idx.dimension((d: any) => d.author.gender)
    const genderGroup = genderDimension.group().reduceCount()

    const languageDimension = idx.dimension((d: any) => d.language)
    const languageGroup = languageDimension.group().reduceCount()

    const baselineHeight = 14
    const tileWidth = 300
    const rowBarRatio = 0.25

    const margins = {
      top: 0,
      right: 0,
      bottom: 0,
      left: baselineHeight,
    }
    const countChart = dataCount("#dc-explorer__tile__chart--count")
    countChart.dimension(idx).group(idx.groupAll())

    createRowChart("university", universityDimension, universityGroup)
    createBarChart("year", yearDimension, yearGroup)
    createRowChart("degree", degreeDimension, degreeGroup)
    createRowChart("gender", genderDimension, genderGroup)
    createRowChart("language", languageDimension, languageGroup)

    renderAll()

    const resetButtons = document.querySelectorAll("button.dc-explorer__reset")
    resetButtons.forEach((button) => {
      button.addEventListener("click", function (e) {
        const chartId = (e.currentTarget as HTMLElement).getAttribute(
          "data-chart"
        )
        if (chartId) charts.get(chartId)?.filterAll()
        renderAll()
        e.preventDefault()
      })
    })
  </script>
</div>
