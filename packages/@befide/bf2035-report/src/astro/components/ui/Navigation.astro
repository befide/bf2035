---
import { getPath, getPrevNext } from '@utils/getSections'

const { id } = Astro.params

const { prev, next, home } = await getPrevNext(id)
---

{
  home && (
    <a id="navigation__home" href={getPath(home)} class="home toolbox-item">
      <span class="icon" />
      <span class="label visually-hidden">Home</span>
    </a>
  )
}
{
  prev && (
    <a id="navigation__prev" href={getPath(prev)} class="prev toolbox-item">
      <span class="icon" />
      <span class="label visually-hidden">zurück</span>
    </a>
  )
}
{
  next && (
    <a id="navigation__next" class="next toolbox-item" href={getPath(next)}>
      <span class="icon" />
      <span class="label visually-hidden">vor</span>
    </a>
  )
}

<script is:inline>
  document.addEventListener('keydown', function (e) {
    if (e.ctrlKey && e.code === 'KeyN') {
      document.getElementById('navigation__next')?.click()
    }
  })
  document.addEventListener('keydown', function (e) {
    if (e.ctrlKey && e.shiftKey && e.code === 'KeyH') {
      document.getElementById('navigation__home')?.click()
    }
  })
  document.addEventListener('keydown', function (e) {
    if (e.ctrlKey && e.shiftKey && e.code === 'KeyN') {
      document.getElementById('navigation__prev')?.click()
    }
  })
</script>

<style is:global>
  .toolbox-item .icon {
    content: ' ';
    display: inline-block;
    flex: 0 0 1rem;
    height: 1rem;
    background-position: center center;
    background-size: 0.75rem;

    background-repeat: no-repeat;
  }
  .toolbox-item .label {
    flex: 1 0 6rem;
    padding: 0 0.25rem;
  }

  .home .icon {
    background-image: url('data:image/svg+xml;base64,');
  }
  .prev .icon {
    background-image: url('data:image/svg+xml;base64,');
  }
  .next .icon {
    background-image: url('data:image/svg+xml;base64,');
  }
  .toolbox-item--print-layout .icon {
    background-image: url('data:image/svg+xml;base64,');
  }
  .toolbox-item--debug .icon {
    background-image: url('data:image/svg+xml;base64,');
  }
  .toolbox-item--fit .icon {
    background-image: url('data:image/svg+xml;base64,');
  }
  [data-print-preview='false'] .toolbox-item--print-layout .icon {
    opacity: 0.1;
    transition: 0.5s;
  }
  [data-print-preview='true'] .toolbox-item--print-layout .icon {
    opacity: 1;
    transition: 0.5s;
  }
  [data-debug='false'] .toolbox-item--debug .icon {
    opacity: 0.1;
    transition: 0.5s;
  }
  [data-pdebug='true'] .toolbox-item--debug .icon {
    opacity: 1;
    transition: 0.5s;
  }
  [data-debug='false'] .toolbox-item--debug .icon {
    opacity: 0.1;
    transition: 0.5s;
  }
  [data-pdebug='true'] .toolbox-item--debug .icon {
    opacity: 1;
    transition: 0.5s;
  }
  [data-fit-spread='false'] .toolbox-item--fit .icon {
    opacity: 0.1;
    transition: 0.5s;
  }
  [data-fit-spread='true'] .toolbox-item--fit .icon {
    opacity: 1;
    transition: 0.5s;
  }
</style>
