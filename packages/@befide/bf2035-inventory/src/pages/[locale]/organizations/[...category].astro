---
import {
  allCommunityTopLevelOrganizations,
  getOrganizationCategories,
} from "@utils/content.organizations"

import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro"

const categories = await getOrganizationCategories()

import fastCartesian from "fast-cartesian"
import OrganizationCard from "@/astro/components/domain/OrganizationCard.astro"

export async function getStaticPaths(): Promise<any> {
  const organizationCategories = [...(await getOrganizationCategories()), undefined]
  const locales = ["en", "de"]

  return fastCartesian([organizationCategories, locales]).map(([category, locale]) => ({
    params: { category, locale },
    props: { category },
  }))
}
const { category } = Astro.props
const organizations = (await allCommunityTopLevelOrganizations()).filter(
  (o) => !category || o.data.befideOrganizationCategories.includes(category)
)
---

<StarlightPage frontmatter={{ title: "Profiles Index" }}>
  <p>
    This page lists all scientific institutions in Germany or, in the case of significant German
    funding, abroad, where accelerator research is carried out.
  </p>
  <div id="organization-category-filter-holder">
    <ul>
      {
        categories.map((c) => (
          <li>
            <a
              class={"category--" + c}
              href={c === category ? "/profiles/en/" : "/profiles/en/" + c}
            >
              {c}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <div id="list-holder">
    <div class="card-grid">
      {organizations.map((organization) => <OrganizationCard organization={organization.data} />)}
    </div>
  </div>
</StarlightPage>

<style>
  .card-grid {
    display: grid;
    grid-template-columns: 100%;
    gap: 1rem;
  }

  @media (min-width: 50rem) {
    .card-grid {
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }
  }
</style>
