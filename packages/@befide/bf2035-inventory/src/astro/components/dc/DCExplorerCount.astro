---
import { countChartId, countChartTileId } from "./utils"

const { collection, dimension } = Astro.props

const tileId = countChartTileId(collection, dimension)
const chartId = countChartId(collection, dimension)
const tileType = "count"
---

<section
  class="dc-explorer__tile filter"
  id={tileId}
  data-dc-collection={collection}
  data-dc-dimension={dimension}
  data-dc-tile-type={tileType}
>
  <header class="filter__header">
    <div class="filter__title">Number of items</div>
    <div class="filter__reset">
      <button class="reset">Reset All</button>
    </div>
  </header>
  <div class="filter__body">
    <div id={chartId}>
      <span class="filter-count"></span> selected out of <span class="total-count"></span>
    </div>
  </div>
</section>
