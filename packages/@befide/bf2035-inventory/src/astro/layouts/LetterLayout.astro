---
import "@styles/global.css"

import "@fontsource/barlow-semi-condensed/400.css"
import "@fontsource/barlow-semi-condensed/700.css"

import Navbar from "@components/ui/Navbar.astro"
import Letter from "@components/letter/Letter.astro"
import PagedJSPreview from "@components/print/PagedJSPreview.astro"

export type props = {
  title: string
  description?: string
  keywords?: string[]
  parent?: string
  noIndex?: boolean
  ogImage?: string
}

const { title, description, keywords, parent } = Astro.props

const canonicalURL = new URL(Astro.url.pathname, Astro.site)

// prettier-ignore
const cleanDescription =
  description?.split("\n\n").join(" ").split("\n").join("");
const trimmedDescription =
  cleanDescription && cleanDescription.length > 200
    ? cleanDescription.slice(0, 197) + "..."
    : description
---

<!doctype html>
<html lang="en">
  <head>
    <!-- global metadata and links -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" href="/index.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- primary meta tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={trimmedDescription} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="keywords" content={keywords?.join(", ")} />

    <!-- light/dark mode script -->
    <script is:inline>
      const media = window.matchMedia("(prefers-color-scheme: dark)")

      // set theme before react loads to avoid flash of incorrect theme
      const theme = localStorage.getItem("theme")

      if (theme === "dark" || (!theme && media.matches)) {
        document.documentElement.classList.add("dark")
      }

      // update class when user changes system theme
      media.addEventListener("change", (e) => {
        // if user has already set a theme, don't change it
        if (localStorage.getItem("theme") !== null) return

        if (e.matches) {
          document.documentElement.classList.add("dark")
        } else {
          document.documentElement.classList.remove("dark")
        }
      })
    </script>
  </head>

  <body class="flex min-h-screen flex-col">
    <!-- <Navbar parent={parent} /> -->
    <div id="pagebox">
      <Letter><slot /></Letter>
    </div>

    <PagedJSPreview />
  </body>
</html>

<style>
  html {
    background-image: linear-gradient(
      rgba(160, 160, 160, 0.3) 0px,
      transparent 1px,
      transparent 100%
    );
    background-size: 100% 1rem;
  }
</style>
