---
import "@/astro/styles/dc-explorer.css"
import DCExplorerCount from "@components/dc/DCExplorerCount.astro"
import DCExplorerRowChart from "@components/dc/DCExplorerRowChart.astro"
import DCExplorer from "@components/dc/DCExplorer.astro"
import DCExplorerTable from "../dc/DCExplorerTable.astro"
---

<DCExplorer collection="courses">
  <div class="dc-explorer__filters">
    <DCExplorerCount collection="courses" dimension="count" />
    <DCExplorerRowChart
      collection="courses"
      dimension="university"
      accessorPath="university"
      dimensionIsLocalized={true}
      title={Astro.locals.t("dc-explorer.tiles.title.universities")}
    />
    <DCExplorerRowChart
      collection="courses"
      dimension="instanceOfTeachingEvent"
      dimensionIsLocalized={true}
      accessorPath="instanceOfTeachingEvent"
      title={Astro.locals.t("dc-explorer.tiles.title.teaching-event")}
    />
    <DCExplorerRowChart
      collection="courses"
      dimension="addressesProgrammeOfStudyLevels"
      dimensionIsLocalized={true}
      dimensionIsArray={true}
      title={Astro.locals.t("dc-explorer.tiles.title.study-levels")}
    />
    <DCExplorerRowChart
      collection="courses"
      dimension="semester"
      title={Astro.locals.t("dc-explorer.tiles.title.semester")}
    />
    <DCExplorerRowChart
      collection="courses"
      dimension="sws"
      title="SWS"
      title={Astro.locals.t("dc-explorer.tiles.title.sws")}
    />

    <DCExplorerRowChart
      collection="courses"
      dimension="language"
      title={Astro.locals.t("dc-explorer.tiles.title.languages")}
      dimensionIsArray={true}
    />
  </div>
  <div class="dc-explorer_items">
    <DCExplorerTable collection="courses" dimension="id" />
  </div>
</DCExplorer>
