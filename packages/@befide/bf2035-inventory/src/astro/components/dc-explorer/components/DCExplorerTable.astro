---
import { tableId, tableTileId } from "@components/dc-explorer/utils/index"

const { collection, dimension } = Astro.props

const tileId = tableTileId(collection, dimension)
const chartId = tableId(collection, dimension)
const tileType = "table"
---

<section
  class="dc-explorer__tile loading"
  id={tileId}
  data-dc-collection={collection}
  data-dc-dimension={dimension}
  data-dc-tile-type={tileType}
>
  <div class="dc-explorer__tile__header">
    <div class="dc-explorer__tile__title">{Astro.locals.t("dc-explorer.tiles.title.items")}</div>
    <div class="dc-explorer__tile__actions">
      <!-- <button class="download-action" data-chart={chartId}
        >{Astro.locals.t("dc-explorer.actions.csv-export")}</button
      > -->
    </div>
  </div>
  <div class="dc-explorer__tile__body">
    <table class="table table-hover table-striped table-bordered" id={chartId}>
      <thead>
        <tr class="table-header">
          <!-- Programmatically insert table headers here -->
        </tr>
      </thead>
    </table>
  </div>
</section>
