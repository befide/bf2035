---
import DCExplorerCount from "@components/dc-explorer/components/DCExplorerCount.astro"
import DCExplorerRowChart from "@components/dc-explorer/components/DCExplorerRowChart.astro"
import DCExplorer from "@components/dc-explorer/components/DCExplorer.astro"
import DCExplorerTable from "@components/dc-explorer/components/DCExplorerTable.astro"
---

<DCExplorer collection="courses">
  <div class="dc-explorer__filters">
    <DCExplorerCount collection="courses" dimension="count" />
    <DCExplorerRowChart
      collection="courses"
      dimension="university"
      accessorPath="university"
      dimensionIsLocalized={true}
      title={Astro.locals.t("dc-explorer.tiles.title.universities")}
    />
    <DCExplorerRowChart
      collection="courses"
      dimension="instanceOfTeachingEvent"
      dimensionIsLocalized={true}
      accessorPath="instanceOfTeachingEvent"
      title={Astro.locals.t("dc-explorer.tiles.title.teaching-event")}
    />
    <DCExplorerRowChart
      collection="courses"
      dimension="addressesProgrammesOfStudyLevels"
      dimensionIsLocalized={true}
      dimensionIsArray={true}
      title={Astro.locals.t("dc-explorer.tiles.title.study-levels")}
    />
    <DCExplorerRowChart
      collection="courses"
      dimension="semsters"
      dimensionIsArray={true}
      title={Astro.locals.t("dc-explorer.tiles.title.semesters")}
    />
    <DCExplorerRowChart
      collection="courses"
      dimension="weeklySemesterHours"
      title={Astro.locals.t("dc-explorer.tiles.title.weeklySemesterHours")}
    />

    <DCExplorerRowChart
      collection="courses"
      dimension="languages"
      title={Astro.locals.t("dc-explorer.tiles.title.languages")}
      dimensionIsArray={true}
    />
  </div>
  <div class="dc-explorer_items">
    <DCExplorerTable collection="courses" dimension="id" />
  </div>
</DCExplorer>
