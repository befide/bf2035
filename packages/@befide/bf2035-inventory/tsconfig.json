{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "types": ["vite-plugin-pwa/info.d.ts", "vite-plugin-pwa/client.d.ts"],
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@components/*": ["src/astro/components/*"],
      "@styles/*": ["src/astro/styles/*"],
      "@utils/*": ["src/astro/domain/*"],
      "@nanostore/*": ["src/astro/nanostore/*"],
      "@domain/*": ["src/astro/domain/*"],
      "@content/*": ["src/content/*"]
    },
    "jsx": "preserve"
  }
}
