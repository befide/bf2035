{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "types": ["vite-plugin-pwa/info.d.ts", "vite-plugin-pwa/client.d.ts"],
    "skipLibCheck": true,
    "verbatimModuleSyntax": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@components/*": ["src/astro/components/*"],
      "@styles/*": ["src/astro/styles/*"],
      "@utils/*": ["src/astro/domain/*"],
      "@nanostore/*": ["src/astro/nanostore/*"],
      "@domain/*": ["src/astro/domain/*"],
      "@content/*": ["src/content/*"],
      "@assets/*": ["src/content/assets/*"]
    },
    "jsx": "preserve"
  },
  "ts-node": {
    "experimentalSpecifierResolution": "node",
    "transpileOnly": true,
    "esm": true
  }
}
