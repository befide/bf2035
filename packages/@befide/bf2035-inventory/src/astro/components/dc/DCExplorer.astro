---
import "@/astro/styles/dc-explorer.css"

export type Theses = Thesis[]

export interface Thesis {
  citationKey: string
  title: string
  author: Author
  language: string
  year: number
  university: string
  organizations: string[]
  facilities: string[]
  degree: string
}

export interface Author {
  familyName: string
  givenName: string
  gender: string
}

const locale = Astro.currentLocale
---

<div id="explorer" class="explorer" data-locale={locale}>
  <slot />
</div>
<script>
  import { $thesesIndex } from "@/astro/store/thesesIndex"
  import "dc/src/compat/d3v6"

  import { config, redrawAll, renderAll } from "dc"

  import {
    charts,
    createBarChart,
    createRowChart,
    createCountChart,
    createTableChart,
    getTableConfig,
    getValue,
  } from "./utils"

  config.defaultColors(["schemeCategory10"])

  $thesesIndex.listen(() => {
    const idx = $thesesIndex.get()

    const filters = document.getElementsByClassName("dc-explorer__tile")
    Array.from(filters).forEach((filter) => {
      const { dcTileType, dcCollection, dcDimension, dcAccessorPath, dcDimensionMultiple } =
        filter.dataset

      if (dcTileType === "count") {
        /*something here*/

        createCountChart(dcCollection, dcDimension, idx)
      } else if (dcTileType === "row-chart") {
        // something here

        const dimension = idx.dimension(
          (d) => getValue(d, dcAccessorPath || dcDimension) || "other",
          dcDimensionMultiple
        )
        const group = dimension.group().reduceCount()

        createRowChart(dcCollection, dcDimension, dimension, group)
      } else if (dcTileType === "bar-chart") {
        const dimension = idx.dimension(
          (d) => getValue(d, dcAccessorPath || dcDimension) || "other"
        )

        const group = dimension.group()

        createBarChart(dcCollection, dcDimension, dimension, group)
      } else if (dcTileType === "table") {
        const idDimension = idx.dimension((d) => d)
       
        createTableChart(dcCollection, dcDimension, getTableConfig("theses"), idDimension)
      }
    })

    renderAll()

    const resetButtons = document.querySelectorAll("button.reset")
    resetButtons.forEach((button) => {
      button.addEventListener("click", function (e) {
        const chartId = (e.currentTarget as HTMLElement).getAttribute("data-chart")
        console.log(chartId)
        if (chartId) charts.get(chartId)?.filterAll()

        redrawAll()
        e.preventDefault()
      })
    })
  })
</script>
