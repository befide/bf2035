---
import { treeDataTableId, treeDataTableTileId } from "./utils/index"

const { collection, dimension, title } = Astro.props

const tileId = treeDataTableTileId(collection, dimension)
const chartId = treeDataTableId(collection, dimension)
const tileType = "tree-data-table"
---

<section
  class="dc-explorer__tile loading"
  id={tileId}
  data-dc-collection={collection}
  data-dc-dimension={dimension}
  data-dc-tile-type={tileType}
>
  <div class="dc-explorer__tile__header">
    <h2>{title}</h2>
    <button class="download">Download as csv</button>
  </div>
  <div class="dc-explorer__tile__body">
    <table class="table table-hover table-striped table-bordered" id={chartId}>
      <thead>
        <tr class="table-header">
          <!-- Programmatically insert table headers here -->
        </tr>
      </thead>
    </table>
  </div>
</section>
